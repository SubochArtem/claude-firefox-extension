{
  "name": "claude-firefox-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p extension && tsc --noEmit -p host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "web-ext lint",
    "start": "web-ext run",
    "install-host": "node scripts/install-host.mjs",
    "uninstall-host": "node scripts/install-host.mjs --uninstall",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
