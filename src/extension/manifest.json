{
  "manifest_version": 3,
  "name": "Claude Firefox Extension",
  "version": "0.1.0",
  "description": "Lets Claude Code control Firefox through a local native messaging host.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["alarms", "nativeMessaging", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-firefox-extension@localhost",
      "strict_min_version": "158.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
